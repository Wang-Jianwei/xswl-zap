{
  "name": "xswl-zap-vna-tools",
  "displayName": "XSWL ZAP VNA Tools",
  "description": "MVP VS Code extension for xswl-zap vna backend",
  "version": "0.0.1",
  "publisher": "xswl",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:xswlZapVna.controlCenterView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xswlZapVna",
          "title": "XSWL VNA",
          "icon": "resources/xswl-vna-activity.svg"
        }
      ]
    },
    "views": {
      "xswlZapVna": [
        {
          "id": "xswlZapVna.controlCenterView",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "xswlZapVna.getServiceStatus",
        "title": "XSWL: Get Service Status"
      },
      {
        "command": "xswlZapVna.getInstanceCapabilities",
        "title": "XSWL: Get Instance Capabilities"
      },
      {
        "command": "xswlZapVna.validateTopology",
        "title": "XSWL: Validate Topology"
      },
      {
        "command": "xswlZapVna.editWorkspaceTopology",
        "title": "XSWL: Edit Workspace Topology"
      },
      {
        "command": "xswlZapVna.openControlCenter",
        "title": "XSWL: Open Control Center"
      },
      {
        "command": "xswlZapVna.openControlCenterMaximized",
        "title": "Maximize Control Center",
        "icon": "$(screen-full)"
      },
      {
        "command": "xswlZapVna.closeControlCenterSidebar",
        "title": "Close Control Center Sidebar",
        "icon": "$(close)"
      },
      {
        "command": "xswlZapVna.acquireOnce",
        "title": "XSWL: Acquire Once"
      },
      {
        "command": "xswlZapVna.streamPreview",
        "title": "XSWL: Stream Preview"
      },
      {
        "command": "xswlZapVna.importAcquisition",
        "title": "XSWL: Import Acquisition"
      },
      {
        "command": "xswlZapVna.compareImportedAcquisition",
        "title": "XSWL: Compare Imported Acquisition"
      },
      {
        "command": "xswlZapVna.batchCompareImportedAcquisition",
        "title": "XSWL: Batch Compare Imported Acquisition"
      },
      {
        "command": "xswlZapVna.previewWaveform",
        "title": "XSWL: Preview Waveform"
      },
      {
        "command": "xswlZapVna.openOutput",
        "title": "XSWL: Open Output"
      },
      {
        "command": "xswlZapVna.clearOutput",
        "title": "XSWL: Clear Output"
      }
    ],
    "keybindings": [
      {
        "command": "xswlZapVna.openOutput",
        "key": "ctrl+alt+o"
      },
      {
        "command": "xswlZapVna.clearOutput",
        "key": "ctrl+alt+l"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "xswlZapVna.openControlCenterMaximized",
          "when": "view == xswlZapVna.controlCenterView",
          "group": "navigation@1"
        },
        {
          "command": "xswlZapVna.closeControlCenterSidebar",
          "when": "view == xswlZapVna.controlCenterView",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "xswlZapVna.openOutput",
          "group": "navigation@90"
        },
        {
          "command": "xswlZapVna.clearOutput",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "XSWL ZAP VNA",
      "properties": {
        "xswlZapVna.grpcAddress": {
          "type": "string",
          "default": "127.0.0.1:50051",
          "description": "VNA gRPC service address"
        },
        "xswlZapVna.grpcDeadlineMs": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "description": "Deadline in milliseconds for gRPC unary calls"
        },
        "xswlZapVna.autoOpenOutput": {
          "type": "boolean",
          "default": true,
          "description": "Auto focus XSWL VNA output channel after commands"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "npm run build && node ./out/test/statusFormatter.test.js && node ./out/test/waveformPreview.test.js && node ./out/test/liveWaveformOverlay.test.js && node ./out/test/serviceClient.test.js && node ./out/test/lockDiagnostics.test.js && node ./out/test/unifiedControlCenter.test.js && node ./out/test/extensionManifest.test.js",
    "test:ui": "npm run build && node ./out/test/waveformPreview.ui.test.js && node ./out/test/unifiedControlCenter.ui.test.js",
    "test:ui:control-center": "npm run build && node ./out/test/unifiedControlCenter.ui.test.js",
    "test:ui:grpc": "npm run build && node ./out/test/waveformPreview.grpc.ui.e2e.test.js",
    "start:ui": "npm run build && node ./scripts/start-ui-dev.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/vscode": "^1.90.0",
    "playwright-core": "^1.53.2",
    "ts-proto": "^2.11.2",
    "typescript": "^5.7.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0"
  }
}
