{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build vna extension",
      "type": "shell",
      "command": "npm",
      "args": [
        "--prefix",
        "${workspaceFolder}/vna/tools/vscode-extension",
        "run",
        "build"
      ],
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "npm: watch vna extension",
      "type": "shell",
      "command": "npm",
      "args": [
        "--prefix",
        "${workspaceFolder}/vna/tools/vscode-extension",
        "run",
        "watch"
      ],
      "isBackground": true,
      "group": "build",
      "problemMatcher": [
        "$tsc-watch"
      ]
    }
  ]
}
