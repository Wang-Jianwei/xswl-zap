{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VNA Extension (subfolder)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vna/tools/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vna/tools/vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "npm: build vna extension"
    },
    {
      "name": "Run VNA Extension (watch)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vna/tools/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vna/tools/vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "npm: watch vna extension"
    }
  ]
}
